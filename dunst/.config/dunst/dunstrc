[global]
    follow = mouse
    offset = (20, 10)
    width = 450
    height = (0, 200)
    notification_limit = 5
    progress_bar_max_width = 450

    font = JetBrainsMono Nerd Font 14
    frame_width = 2
    frame_color = "#8aadf4"
    highlight = "#8aadf4"
    corner_radius = 5
    padding = 15
    horizontal_padding = 15

    idle_threshold = 120
    word_wrap = yes
    min_icon_size = 0
    max_icon_size = 64

[urgency_low]
    background = "#24273a"
    foreground = "#cad3f5"
    timeout = 5

[urgency_normal]
    background = "#24273a"
    foreground = "#cad3f5"

[urgency_critical]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#f5a97f"

# volume and brightness popups, see hypr/scripts/osd.sh
[osd]
    appname = osd
    history_ignore = yes

[battery_low]
    appname = battery
    urgency = normal
    frame_color = "#eed49f"
    highlight = "#eed49f"

[battery_critical]
    appname = battery
    urgency = critical
    frame_color = "#ed8796"
    highlight = "#ed8796"
