{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 12,
    "margin-left": 12,
    "margin-right": 12,
    "reload_style_on_change": true,

    "modules-left": ["group/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "tray", "custom/divider", "wireplumber#microphone", "wireplumber", "battery", "hyprland/language"],

    "custom/divider": {
        "format": "│",
        "tooltip": false
    },

    // own modules, the built-in ones do not work with a lua config
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"]
    },

    "custom/ws1": {
        "exec": "~/.config/hypr/scripts/ws.py 1",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },

    "custom/ws2": {
        "exec": "~/.config/hypr/scripts/ws.py 2",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },

    "custom/ws3": {
        "exec": "~/.config/hypr/scripts/ws.py 3",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },

    "custom/ws4": {
        "exec": "~/.config/hypr/scripts/ws.py 4",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
    },

    "custom/ws5": {
        "exec": "~/.config/hypr/scripts/ws.py 5",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
    },

    "mpris": {
        "format": "<span alpha='25%'>│</span>  {player_icon} {dynamic}",
        "format-paused": "<span alpha='25%'>│</span>  󰏤 {dynamic}",
        "dynamic-order": ["artist", "title"],
        "max-length": 32,
        "player-icons": {
            "default": "󰐊",
            "spotify": "󰓇",
            "firefox": "󰈹"
        }
    },

    "clock": {
        "format": "<span alpha='60%'>{0:%a %d %b}</span>  {0:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // only visible when the machine is busy
    "cpu": {
        "interval": 5,
        "states": { "busy": 70 },
        "format": "",
        "format-busy": "󰻠 {usage}%",
        "on-click": "alacritty -e htop"
    },

    "memory": {
        "interval": 5,
        "states": { "busy": 80 },
        "format": "",
        "format-busy": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "wireplumber#microphone": {
        "node-type": "Audio/Source",
        "format": "󰍬",
        "format-muted": "󰍭",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pkill -x pavucontrol || pavucontrol",
        "on-scroll-up": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "battery": {
        "bat": "BAT0",
        "on-click": "~/.config/hypr/scripts/charge-limit.sh",
        "on-click-right": "~/.config/hypr/scripts/charge-limit.sh status",
        "interval": 60,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "hyprland/language": {
        "format": "<span text_transform='uppercase'>{short}</span>"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 16
    }
}
