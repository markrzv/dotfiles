[global]
    follow = mouse
    offset = (12, 12)
    width = 440
    height = (0, 200)
    notification_limit = 5
    progress_bar_max_width = 440

    font = JetBrainsMono Nerd Font 12
    frame_width = 1
    corner_radius = 10
    padding = 12
    horizontal_padding = 12

    idle_threshold = 120
    word_wrap = yes
    min_icon_size = 0
    max_icon_size = 64

[urgency_low]
    timeout = 5

# volume and brightness popups, see hypr/scripts/osd.sh
[osd]
    appname = osd
    history_ignore = yes
    override_pause_level = 100

# colors are in dunstrc.d/colors.conf
