#!/usr/bin/env bash
# switch colors and wallpaper: theme <name> or theme menu
set -euo pipefail

dir="$HOME/.config/theme"
config="$HOME/.config"

if [ "${1:-}" = "menu" ]; then
    current=$(cat "$dir/current" 2>/dev/null || true)
    choice=$(ls "$dir/palettes" | sed 's/\.sh$//' | rofi -dmenu -i -p theme -select "$current") || exit 0
    exec "$0" "$choice"
fi

if [ $# -eq 0 ]; then
    echo "current:   $(cat "$dir/current" 2>/dev/null || echo none)"
    echo "available: $(ls "$dir/palettes" | sed 's/\.sh$//' | tr '\n' ' ')"
    exit
fi

name=$1
[ -f "$dir/palettes/$name.sh" ] || { echo "unknown theme: $name" >&2; exit 1; }
. "$dir/palettes/$name.sh"

cat > "$config/hypr/colors.lua" <<EOF
-- generated by theme, do not edit
return {
    bg = "$bg", bg_alt = "$bg_alt", surface = "$surface", overlay = "$overlay",
    fg = "$fg", fg_muted = "$fg_muted", accent = "$accent", accent2 = "$accent2",
    red = "$red", yellow = "$yellow", green = "$green",
}
EOF

cat > "$config/hypr/colors.conf" <<EOF
# generated by theme, do not edit
\$bg = rgb($bg)
\$fg = rgb($fg)
\$fg_muted = rgb($fg_muted)
\$accent = rgb($accent)
\$accent2 = rgb($accent2)
\$green = rgb($green)
\$red = rgb($red)
EOF

cat > "$config/waybar/colors.css" <<EOF
/* generated by theme, do not edit */
@define-color bg_alt #$bg_alt;
@define-color overlay #$overlay;
@define-color fg #$fg;
@define-color fg_muted #$fg_muted;
@define-color accent #$accent;
@define-color yellow #$yellow;
@define-color red #$red;
EOF

cat > "$config/rofi/colors.rasi" <<EOF
/* generated by theme, do not edit */
* {
  base: #$bg;
  mantle: #$bg_alt;
  text: #$fg;
  red: #$red;
  blue: #$accent;
}
EOF

mkdir -p "$config/dunst/dunstrc.d"
cat > "$config/dunst/dunstrc.d/colors.conf" <<EOF
# generated by theme, do not edit
[global]
    frame_color = "#$accent"
    highlight = "#$accent"

[urgency_low]
    background = "#$bg"
    foreground = "#$fg"

[urgency_normal]
    background = "#$bg"
    foreground = "#$fg"

[urgency_critical]
    background = "#$bg"
    foreground = "#$fg"
    frame_color = "#$orange"

[battery_low]
    appname = battery
    urgency = normal
    frame_color = "#$yellow"
    highlight = "#$yellow"

[battery_critical]
    appname = battery
    urgency = critical
    frame_color = "#$red"
    highlight = "#$red"
EOF

cat > "$config/alacritty/colors.toml" <<EOF
# generated by theme, do not edit
[colors.primary]
background = "#$bg"
foreground = "#$fg"

[colors.cursor]
text = "#$bg"
cursor = "#$cursor"

[colors.selection]
text = "#$bg"
background = "#$cursor"

[colors.normal]
black = "#$overlay"
red = "#$red"
green = "#$green"
yellow = "#$yellow"
blue = "#$blue"
magenta = "#$purple"
cyan = "#$cyan"
white = "#$fg_muted"

[colors.bright]
black = "#$grey"
red = "#$red"
green = "#$green"
yellow = "#$yellow"
blue = "#$blue"
magenta = "#$purple"
cyan = "#$cyan"
white = "#$fg"
EOF

cat > "$config/zsh/colors.zsh" <<EOF
# generated by theme, do not edit
c_fg=$fg
c_accent=$accent
c_accent2=$accent2
c_green=$green
EOF

# nm-applet icons in the text color
mono="$HOME/.local/share/icons/mono"
icons="$mono/scalable/status"
mkdir -p "$icons"
cat > "$mono/index.theme" <<EOF
[Icon Theme]
Name=mono
Inherits=mate
Directories=scalable/status

[scalable/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status
EOF
for file in /usr/share/icons/hicolor/scalable/apps/nm-*-symbolic.svg; do
    sed -E "s/#(000000|000|2e3436|474747|666666|bebebe|ffffff)\b/#$fg/gI" "$file" > "$icons/$(basename "$file" -symbolic.svg).svg"
done
for icon in /usr/share/icons/hicolor/*/apps/nm-stage0*-connecting*; do
    cp "$icons/nm-signal-00.svg" "$icons/$(basename "${icon%.*}").svg"
done

wallpaper=$(ls "$dir/wallpapers/$name".* 2>/dev/null | head -1 || true)
ln -sfn "${wallpaper:-$config/hypr/wallpaper.example.png}" "$config/hypr/wallpaper.png"

echo "$name" > "$dir/current"

# reload what is running
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl reload >/dev/null
    pkill -SIGUSR2 -x waybar || true
    dunstctl reload 2>/dev/null || true
    pkill -x hyprpaper || true
    hyprctl dispatch 'hl.dsp.exec_cmd("hyprpaper")' >/dev/null
fi

echo "theme: $name"
